*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# Cache
.vite/
.eslintcache
.cache/

# Runtime
*.db
*.sqlite
*.sqlite3
/tmp/

# TTS 生成音频（运行时产物）
public/audio/

# Build/dev caches
*.tsbuildinfo
vite.config.js.timestamp-*.mjs
vite.config.ts.timestamp-*.mjs

# Sensitive / local
.env.bak
.cookie-extract/
.tmp-cookie-grab/
docs/_shot/

# 本地音乐库（1GB mp3，绝不能进仓库；manifest.json 需手动另传 COS）
library/
library_test/
tools/ncmdump/

# SQLite 运行时历史库（重启回填用，二进制运行时产物不入库）
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal

# 主人云端档案（运行时个人同步配置，不入库）
data/owner-settings.json

# 主人聊天档案（运行时个人历史对话，不入库）
data/owner-chat.json
