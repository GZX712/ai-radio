{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "NODE_ENV": "production"
      },
      "prebuildCommand": "npm run build && npx cap add ios && npx cap sync ios"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production"
      },
      "prebuildCommand": "npm run build && npx cap add ios && npx cap sync ios"
    }
  },
  "submit": {
    "production": {}
  }
}
